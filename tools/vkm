#!/bin/sh
# vkm: runs vkm.py on the SDK's own Python, or on the system's in the engine's tree.
# Links resolved first, so a link to it on PATH runs the SDK it points into.
here=$(dirname "$(readlink -f "$0")")
prog="$here/vkm.py"
[ -f "$here/bin/vkm.py" ] && prog="$here/bin/vkm.py"
for python in "$here/python/bin/python3" "$here/python/python.exe"; do
    [ -x "$python" ] && exec "$python" "$prog" "$@"
done
exec python3 "$prog" "$@"
