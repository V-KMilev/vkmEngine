#!/usr/bin/env python3
"""vkm - the command line for a vkmEngine project.

A project is a directory: project.json says what the game is, src/ holds the
gameplay code that becomes one loadable module, and assets/ scenes/ hold what it
plays. This tool is the whole interface to that - nobody writing a game should
have to write CMake, and nothing here does anything the hosts could not be told
to do by hand.

    vkm new <name>        make a project from the SDK template
    vkm build <project>   compile the project's gameplay module
    vkm run <project>     play it
    vkm edit <project>    open it in the editor
    vkm cook <project>    bake its assets, no window needed
    vkm package <project> assemble a standalone game

Run from an installed SDK, the engine sits beside this script. Run from the
engine's own build tree, it finds that instead, so the tool is testable before
there is anything installed.
"""

# Annotations stay lazy so the tool runs on older interpreters than the one it
# was written with - a user's machine is not ours to pick.
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


# --------------------------------------------------------------------------
# Locating the SDK
# --------------------------------------------------------------------------

def sdk_root() -> Path:
    """The engine root this script belongs to.

    Installed, that is the directory above bin/. In the engine's own tree it is
    the repo root, with binaries under build/bin. Checked in that order because
    an installed SDK is the normal case and the build tree is the exception.
    """
    if env := os.environ.get("VKM_ENGINE_ROOT"):
        return Path(env).resolve()

    here = Path(__file__).resolve().parent
    if (here.parent / "shaders").is_dir() and (here / "vkm_runtime").exists():
        return here.parent                      # <prefix>/bin/vkm
    if (here.parent / "shaders").is_dir():
        return here.parent                      # <repo>/tools/vkm
    die("cannot locate the engine. Set VKM_ENGINE_ROOT to the SDK directory.")


def sdk_compiler(root: Path) -> str | None:
    """The C++ compiler the engine was built with, as its config records it.

    The engine is not ABI-stable across compilers, so a project has to use the
    same one. CMake picks a compiler before it ever reads find_package's config,
    which means the check there can only report the mismatch after the fact - on
    a machine with both GCC and Clang installed it is a coin flip. Reading it out
    here and passing it back makes the right choice the default.
    """
    for cfg in (root / "lib" / "cmake" / "vkmEngine" / "vkmEngineConfig.cmake",
                root / "build" / "lib" / "cmake" / "vkmEngine" / "vkmEngineConfig.cmake"):
        if not cfg.is_file():
            continue
        m = re.search(r'set\(VKMENGINE_BUILD_CXX_COMPILER\s+"([^"]+)"\)', cfg.read_text())
        if m:
            return m.group(1)
    return None


def sdk_version(root: Path) -> str | None:
    """This SDK's MAJOR.MINOR, as its package version file records it.

    A generated project asks find_package for the engine that generated it. The
    package is SameMinorVersion-compatible, so the patch digit is noise here -
    1.6.0 and 1.6.3 answer the same request, and pinning one would reject the
    other for nothing.
    """
    for cfg in (root / "lib" / "cmake" / "vkmEngine" / "vkmEngineConfigVersion.cmake",
                root / "build" / "vkmEngineConfigVersion.cmake"):
        if not cfg.is_file():
            continue
        m = re.search(r'set\(PACKAGE_VERSION\s+"(\d+)\.(\d+)', cfg.read_text())
        if m:
            return f"{m.group(1)}.{m.group(2)}"
    return None


def host(root: Path, name: str) -> Path:
    """Path to one of the three host executables, wherever this SDK keeps them."""
    exe = name + (".exe" if os.name == "nt" else "")
    for candidate in (root / "bin" / exe, root / "build" / "bin" / exe):
        if candidate.exists():
            return candidate
    die(f"{name} not found under {root}. Build the engine first, or check the SDK.")


# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------

def die(msg: str):
    print(f"vkm: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kw) -> int:
    """Run a command, echoing it first so a failure can be reproduced by hand."""
    print("+", " ".join(str(c) for c in cmd))
    return subprocess.call([str(c) for c in cmd], **kw)


def warn_if_offpath(compiler: Path):
    """Warn when a Windows compiler's own directory is not on PATH.

    A compiler needs its runtime DLLs, and on Windows those are found through
    PATH rather than through anything recorded in the binary. Invoke one whose
    directory is absent - the usual cause is driving a UCRT64 toolchain from an
    MSYS2 MINGW64 shell, or the reverse - and it loads a sibling's DLLs and dies
    before printing anything. CMake reports only that the compiler "is not able
    to compile a simple test program", with an empty error, which sends people
    looking at the compiler rather than at the shell they launched it from.
    """
    if os.name != "nt":
        return
    d = compiler.parent.resolve()
    on_path = any(Path(p).resolve() == d
                  for p in os.environ.get("PATH", "").split(os.pathsep) if p)
    if not on_path:
        print(f"vkm: warning: {d} is not on PATH.\n"
              f"     {compiler.name} may fail to load its own runtime and report a\n"
              f"     broken compiler with no error text. Build from the shell that\n"
              f"     owns this toolchain, or put its bin directory on PATH.",
              file=sys.stderr)


def project_dir(arg: str | None) -> Path:
    """Resolve a project argument, defaulting to the working directory.

    Accepts the project directory or any path inside it, the same rule the hosts
    use, so `vkm run` works from within a project without naming it.
    """
    p = Path(arg or ".").resolve()
    probe = p
    while True:
        if (probe / "project.json").is_file():
            return probe
        if probe.parent == probe:
            die(f"no project.json in '{p}' or any directory above it")
        probe = probe.parent


def read_project(d: Path) -> dict:
    try:
        return json.loads((d / "project.json").read_text())
    except json.JSONDecodeError as e:
        die(f"{d / 'project.json'} is not valid JSON: {e}")


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

def cmd_new(args) -> int:
    root = sdk_root()
    template = root / "templates" / "default"
    if not template.is_dir():
        die(f"no project template at {template}")

    dest = Path(args.name).resolve()
    if dest.exists() and any(dest.iterdir()):
        die(f"'{dest}' already exists and is not empty")

    shutil.copytree(template, dest, dirs_exist_ok=True)

    # The template is generic; the project is not. Name it after the directory
    # the user chose rather than making them edit JSON as a first act.
    pj = dest / "project.json"
    data = json.loads(pj.read_text())
    data["name"] = dest.name
    pj.write_text(json.dumps(data, indent=4) + "\n")

    # The template asks for "@VKM_ENGINE_VERSION@"; only this side knows which
    # engine is answering. Refusing to write a project we know cannot configure
    # is better than handing over one that fails on the next command.
    version = sdk_version(root)
    if not version:
        die(f"cannot read the engine version from {root}; the SDK looks incomplete")
    cml = dest / "CMakeLists.txt"
    cml.write_text(cml.read_text().replace("@VKM_ENGINE_VERSION@", version))

    print(f"created {dest}")
    print(f"  vkm build {dest.name} && vkm run {dest.name}")
    return 0


def cmd_build(args) -> int:
    d = project_dir(args.project)
    root = sdk_root()
    build = d / "build"

    cmake = shutil.which("cmake")
    if not cmake:
        die("cmake is not on PATH")

    # Point find_package straight at this SDK's config directory. CMAKE_PREFIX_PATH
    # alone would work for an installed layout, but naming vkmEngine_DIR also works
    # when the tool is run from the engine's build tree.
    config_dir = root / "lib" / "cmake" / "vkmEngine"
    if not config_dir.is_dir():
        config_dir = root / "build" / "lib" / "cmake" / "vkmEngine"

    cfg = [cmake, "-S", d, "-B", build,
           f"-DvkmEngine_DIR={config_dir}",
           f"-DCMAKE_PREFIX_PATH={root}"]

    # Configure with the engine's own compiler unless told otherwise. Skipped
    # once a build directory exists, because CMake will not accept a compiler
    # change in place and re-stating the same one is harmless but noisy.
    compiler = args.compiler or sdk_compiler(root)
    if compiler and not (build / "CMakeCache.txt").exists():
        # An SDK built elsewhere records a path that may not exist here. Say so
        # rather than handing CMake something that does not resolve - and rather
        # than falling silently back to whichever compiler it finds, which is the
        # coin flip this exists to remove.
        if not Path(compiler).exists() and not shutil.which(compiler):
            die(f"the engine was built with '{compiler}', which is not on this "
                f"machine.\n     Install it, or name an equivalent with "
                f"--compiler, or rebuild the engine here.")
        warn_if_offpath(Path(compiler))
        cfg.append(f"-DCMAKE_CXX_COMPILER={compiler}")

    if args.generator:
        cfg += ["-G", args.generator]
    cfg += args.cmake_args

    rc = run(cfg)
    if rc:
        return rc
    return run([cmake, "--build", build] + (["--config", args.config] if args.config else []))


def _host_cmd(args, name) -> int:
    d = project_dir(args.project)
    return run([host(sdk_root(), name), d])


def cmd_run(args)  -> int: return _host_cmd(args, "vkm_runtime")
def cmd_edit(args) -> int: return _host_cmd(args, "vkm_editor")
def cmd_cook(args) -> int: return _host_cmd(args, "vkm_cook")


# Engine data a package carries, and the only engine data an installed SDK has:
# cmake/install.cmake ships shaders/ plus the editor's font and logo, and nothing
# else. Naming them rather than copying the engine's assets/ wholesale is what
# makes a package built from the engine's own tree the same thing as one built
# from an install - the repo's assets/ also holds the sample art the engine
# develops against, which is gigabytes and belongs to no game.
#
# shaders/ is load-bearing twice over: it is what the runtime recognises a
# packaged layout by, rooting itself at whichever directory has one.
ENGINE_DATA = ("shaders", "assets/fonts", "assets/logo")

# Project directories a game reads while it plays. cooked/ is the art in the only
# form the runtime can open; scenes/ and prefabs/ are the documents naming it -
# a scene stores a prefab instance as a reference to its file, so a package
# without prefabs/ instantiates nothing.
PROJECT_DATA = ("scenes", "prefabs", "cooked")

# The asset database, of which a game needs exactly two parts. _manifest.json is
# how an asset name in a scene resolves to anything at all, and a material's
# recipe IS its runtime form - the loader reads that file straight back. The
# other four kinds cook to a binary; their recipes only record how the source art
# was imported, name paths on the machine that imported it, and could not be
# acted on by a runtime that links no importers.
RUNTIME_LIBRARY = ("_manifest.json", "materials")


def import_sources(project: Path) -> set[Path]:
    """Every file or folder the cook imported from, as its own recipes record it.

    A recipe's `source.path` is where an asset came from - a .glb, a texture, a
    PBR folder. That is the authoring half: the runtime reads the cooked binary
    instead and links no importer that could open the original, so shipping both
    hands the player the raw art and pays for it twice.

    What no recipe names is not import material and does ship, because the
    runtime does open some files by path: an environment map, the game's window
    icon. An unreadable recipe excludes nothing, which errs toward a package that
    is too big rather than one missing a file it needed.
    """
    sources: set[Path] = set()
    for recipe in (project / "library").rglob("*.json"):
        try:
            doc = json.loads(recipe.read_text())
        except (OSError, ValueError):
            continue
        source = doc.get("source") if isinstance(doc, dict) else None
        path = source.get("path") if isinstance(source, dict) else None
        if isinstance(path, str) and path:
            sources.add((project / path).resolve())
    return sources


def copy_except(src: Path, dst: Path, skip: set[Path]):
    """Copy a tree, leaving out `skip` - files and whole folders alike.

    A folder whose entire contents were skipped leaves an empty shell behind, so
    those are pruned afterwards rather than shipped as a directory of nothing.
    """
    shutil.copytree(src, dst, dirs_exist_ok=True,
                    ignore=lambda directory, names:
                        {n for n in names if (Path(directory) / n).resolve() in skip})

    for dirpath, _, _ in os.walk(dst, topdown=False):
        empty = Path(dirpath)
        if not any(empty.iterdir()):
            empty.rmdir()


def cmd_package(args) -> int:
    """Assemble a standalone game.

    A packaged game is a renamed copy of vkm_runtime plus what the project needs
    to RUN - the engine executable is never rebuilt for a game. Cooking runs
    first because the runtime can neither import nor cook: it reads what the
    cooker produced, which is also why the authoring half stays behind. Source
    art and the recipes recording how it was imported are how the project is
    made, not what the game plays, and the runtime links no code that can open
    either.
    """
    d = project_dir(args.project)
    root = sdk_root()
    meta = read_project(d)
    name = args.name or meta.get("name") or d.name
    out = Path(args.out or (d / "dist" / name)).resolve()

    if not args.no_cook:
        if rc := run([host(root, "vkm_cook"), d]):
            return rc

    if out.exists():
        shutil.rmtree(out)
    (out / "bin").mkdir(parents=True)

    exe_suffix = ".exe" if os.name == "nt" else ""
    shutil.copy2(host(root, "vkm_runtime"), out / "bin" / (name + exe_suffix))

    # Everything the executable loads, beside it. The binaries carry an $ORIGIN
    # rpath, so the package runs wherever it is unzipped.
    for pattern in ("*.so*", "*.dll"):
        for lib in (root / "bin").glob(pattern):
            shutil.copy2(lib, out / "bin" / lib.name)

    # The gameplay module joins them: the host looks for it under the project's
    # bin/, and in a package the project root and the package root are the same
    # directory. Not the ".loaded." copies beside it - those are what a running
    # host dlopens, and a crashed one leaves behind.
    if (d / "bin").is_dir():
        for f in (d / "bin").iterdir():
            if f.is_file() and ".loaded." not in f.name:
                shutil.copy2(f, out / "bin" / f.name)

    for part in ENGINE_DATA:
        src = root / part
        if src.is_dir():
            shutil.copytree(src, out / part, dirs_exist_ok=True)

    # The project, at the root rather than in a subdirectory. Both roots resolve
    # to the package directory, so this is what lets a player start the game
    # without naming a path - which is the whole point of shipping one.
    shutil.copy2(d / "project.json", out / "project.json")
    for part in PROJECT_DATA:
        if (d / part).is_dir():
            shutil.copytree(d / part, out / part, dirs_exist_ok=True)

    for part in RUNTIME_LIBRARY:
        src = d / "library" / part
        if src.is_dir():
            shutil.copytree(src, out / "library" / part, dirs_exist_ok=True)
        elif src.is_file():
            (out / "library").mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, out / "library" / part)

    if (d / "assets").is_dir():
        copy_except(d / "assets", out / "assets", import_sources(d))

    print(f"\npackaged {name} -> {out}")
    print(f"  run it with: {out / 'bin' / (name + exe_suffix)}")
    return 0

# --------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(prog="vkm", description="vkmEngine project tool")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new", help="make a project from the SDK template")
    p.add_argument("name")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("build", help="compile the project's gameplay module")
    p.add_argument("project", nargs="?")
    p.add_argument("-G", "--generator")
    p.add_argument("-c", "--config")
    p.add_argument("--compiler", help="C++ compiler to use (default: the one the engine was built with)")
    p.add_argument("cmake_args", nargs="*", help="extra arguments passed straight to cmake")
    p.set_defaults(fn=cmd_build)

    for name, help_text, fn in (
        ("run",  "play the project",              cmd_run),
        ("edit", "open the project in the editor", cmd_edit),
        ("cook", "bake the project's assets",      cmd_cook),
    ):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("project", nargs="?")
        p.set_defaults(fn=fn)

    p = sub.add_parser("package", help="assemble a standalone game")
    p.add_argument("project", nargs="?")
    p.add_argument("-o", "--out", help="output directory")
    p.add_argument("-n", "--name", help="name for the game executable")
    p.add_argument("--no-cook", action="store_true", help="skip the cook step")
    p.set_defaults(fn=cmd_package)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
