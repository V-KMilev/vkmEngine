#!/usr/bin/env python3
"""List the comments and doc lines a change may have made false.

A comment is usually true when it is written, about code that later moves. This
finds, for a change, every name the change declares or defines - a function, a
type, a constant, a field - and lists every comment and manual line outside the
change that names one of them. Those are the lines that state a fact about what
changed; read each against the new code before committing.

usage: tools/comment_sweep [<git diff range>]

With no range, the change is what the working tree and the index hold against
HEAD; `master...HEAD` sweeps a whole branch. See docs/guides/code-style.md,
"What the build checks in a comment".
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE_DIRS = ("src", "app", "tests", "shaders", "examples", "templates")
SOURCE_SUFFIXES = {".h", ".cpp", ".glsl", ".shader"}

# What a line of code declares: a type, a constant, a function, and in a header
# a field. A local in a .cpp is nobody else's to name.
DECLARES = (
    re.compile(r"\b(?:struct|class|enum(?:\s+class)?|namespace|using)\s+([A-Za-z_]\w{3,})"),
    re.compile(r"\b([A-Z][A-Z0-9_]{3,})\s*="),
    re.compile(r"^\s*(?:[\w:<>,\*&]+\s+)+[\*&]?([A-Za-z_]\w{3,})\s*\("),
    # An out-of-line definition, so a change to a body alone still names it.
    re.compile(r"^\s*(?:[\w:<>,\*&]+\s+)*[\*&]?\w+::(~?[A-Za-z_]\w{3,})\s*\("),
)
FIELD = re.compile(r"^\s*(?:[\w:<>,]+\s+)+(m_\w+|[a-z]\w{3,})\s*(?:=[^=]|;|\{)")

# A name reads as code - camelCase, two or more capitalised words, an underscore
# or all capitals - and so cannot be an English word a sentence happens to use.
CODE_SHAPED = re.compile(r"^(?:[a-z]+[A-Z]\w*|(?:[A-Z][a-z0-9]+){2,}\w*|\w*_\w*|[A-Z][A-Z0-9_]+)$")
NOT_A_DECLARATION = re.compile(r"^\s*(?:return|if|else|for|while|switch|case|delete|throw)\b")


def git(*args):
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=True).stdout


def is_comment(line):
    stripped = line.strip()
    return stripped.startswith(("//", "*", "/*"))


def changed(diff_range):
    """The names a change declares, and the line ranges it touched, per file."""
    args = ["diff", "-U0"] + ([diff_range] if diff_range else ["HEAD"])
    names, touched = set(), {}
    current = None
    for line in git(*args).splitlines():
        # The file a hunk belongs to: the new path, or the old one for a file the
        # change deletes (`+++ /dev/null`), whose removed lines declared names too.
        if line.startswith("--- "):
            current = line[6:] if line.startswith("--- a/") else None
            continue
        if line.startswith("+++ "):
            if line.startswith("+++ b/"):
                current = line[6:]
            continue
        if line.startswith("@@") and current:
            match = re.search(r"\+(\d+)(?:,(\d+))?", line)
            start, count = int(match.group(1)), int(match.group(2) or 1)
            touched.setdefault(current, []).append((start, start + max(count, 1) - 1))
            continue
        if not current or Path(current).suffix not in SOURCE_SUFFIXES:
            continue
        if line[:1] not in "+-" or line.startswith(("+++", "---")):
            continue
        code = line[1:]
        if is_comment(code) or NOT_A_DECLARATION.match(code):
            continue
        found = [n for p in DECLARES for n in p.findall(code)]
        if current.endswith(".h"):
            found += FIELD.findall(code)
        names.update(n for n in found if CODE_SHAPED.match(n))
    return names, touched


def candidates():
    """Every source file and manual page a comment or doc line can live in."""
    for top in SOURCE_DIRS:
        for path in (ROOT / top).rglob("*"):
            if path.suffix in SOURCE_SUFFIXES and "/build/" not in path.as_posix():
                yield path, False
    for path in (ROOT / "docs").rglob("*.md"):
        yield path, True


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    diff_range = sys.argv[1] if len(sys.argv) > 1 else None
    names, touched = changed(diff_range)
    if not names:
        print("The change declares nothing a comment could name.")
        return 0

    pattern = re.compile(r"\b(" + "|".join(sorted(map(re.escape, names))) + r")\b")
    found = {}
    for path, is_page in candidates():
        relative = path.relative_to(ROOT).as_posix()
        own = touched.get(relative, [])
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        for number, line in enumerate(lines, 1):
            if not is_page and not is_comment(line) and "//" not in line:
                continue
            if any(lo <= number <= hi for lo, hi in own):
                continue
            text = line if is_page or is_comment(line) else line[line.index("//"):]
            # A page names code in a code span; its prose is English.
            searched = " ".join(re.findall(r"`([^`]+)`", text)) if is_page else text
            for name in set(pattern.findall(searched)):
                found.setdefault(name, []).append(f"{relative}:{number}: {text.strip()}")

    if not found:
        print(f"{len(names)} name(s) changed; no comment or page elsewhere names one.")
        return 0
    for name in sorted(found):
        print(f"{name}")
        for hit in found[name]:
            print(f"    {hit}")
    print(f"\n{sum(map(len, found.values()))} line(s) to read against the change.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
