# What find_package(vkmEngine) loads: the engine's targets, vkm_add_gameplay_module(),
# and a hard error for a compiler other than the one that built the engine.

include(CMakeFindDependencyMacro)

# Targets CMake's own find modules make, which the targets file names.
find_dependency(Threads)

# A module must be built with the toolchain that built the engine: a mismatch
# links, then crashes at run time. The full path is kept for `vkm build` to
# configure a project with.
set(VKMENGINE_BUILD_CXX_COMPILER         "@CMAKE_CXX_COMPILER@")
set(VKMENGINE_BUILD_CXX_COMPILER_ID      "@CMAKE_CXX_COMPILER_ID@")
set(VKMENGINE_BUILD_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")

# Read by tools/vkm.
set(VKMENGINE_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set(VKMENGINE_PROFILER   "@VKM_PROFILER@")
set(VKMENGINE_ASSERTS    "@VKM_ASSERTS@")

if(NOT VKMENGINE_SKIP_TOOLCHAIN_CHECK)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL VKMENGINE_BUILD_CXX_COMPILER_ID)
        message(FATAL_ERROR
            "vkmEngine was built with ${VKMENGINE_BUILD_CXX_COMPILER_ID} but you are "
            "building with ${CMAKE_CXX_COMPILER_ID}.\n"
            "The engine ships prebuilt libraries and is not ABI-stable across "
            "compilers: a module built this way fails at run time, not at link "
            "time. Use ${VKMENGINE_BUILD_CXX_COMPILER_ID}, or rebuild the engine "
            "with your compiler.\n"
            "The engine was built with: ${VKMENGINE_BUILD_CXX_COMPILER}\n"
            "  vkm build --compiler \"${VKMENGINE_BUILD_CXX_COMPILER}\"\n"
            "To override anyway (you are on your own): "
            "-DVKMENGINE_SKIP_TOOLCHAIN_CHECK=ON"
        )
    endif()

    # Major version only: a patch release of the same compiler does not change
    # the C++ ABI, and demanding an exact match would make the SDK unusable.
    string(REGEX REPLACE "\\..*" "" _vkm_want_major "${VKMENGINE_BUILD_CXX_COMPILER_VERSION}")
    string(REGEX REPLACE "\\..*" "" _vkm_have_major "${CMAKE_CXX_COMPILER_VERSION}")
    if(NOT _vkm_want_major STREQUAL _vkm_have_major)
        message(FATAL_ERROR
            "vkmEngine was built with ${VKMENGINE_BUILD_CXX_COMPILER_ID} "
            "${VKMENGINE_BUILD_CXX_COMPILER_VERSION} but you are building with "
            "${CMAKE_CXX_COMPILER_VERSION}.\n"
            "Major compiler versions change the C++ ABI. Use a "
            "${_vkm_want_major}.x toolchain, or rebuild the engine.\n"
            "To override anyway: -DVKMENGINE_SKIP_TOOLCHAIN_CHECK=ON"
        )
    endif()
    unset(_vkm_want_major)
    unset(_vkm_have_major)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vkmEngineTargets.cmake")

# A file of its own, which the engine's tree includes too.
include("${CMAKE_CURRENT_LIST_DIR}/gameplay_module.cmake")
