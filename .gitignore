.vscode/
.claude/

build*/
cache/

logs/
assets/
screenshots/

# Per-user editor state. It belongs in ProjectPaths::userRoot(), but that root
# falls back to the engine root when the platform names no user directory or
# names one that is not writable - and a dev checkout is where that lands.
editor_recents.json
imgui.ini

editor_settings.json

# Generated by cmake/generate_shader_config.cmake at configure time.
shaders/_generated/
# Derived cooked-asset cache (regenerated by the editor cooker)
/scenes/
/cooked/
/library/
# A project's derived caches, written by the cooker on save and on cook.
examples/*/cooked/
examples/*/library/
# A project's built gameplay module, and the copies ScriptModule loads from.
examples/*/bin/
# Where vkm package assembles a standalone game, by default.
examples/*/dist/
# Our own working plan for where the engine is going. Not part of the manual.
docs/roadmap.md

# Throwaway verification harnesses; never part of the engine.
scratchpad/

# The physics lab is the one example whose world is authored rather than built
# at play time, so unlike the others it cannot make its own contents. Its source
# art and its asset recipes are both source: the scene stores names, and the
# recipes under library/ are what turn those names back into assets. Without
# either, a clone opens the project to an empty world. The cooked binaries
# beside them stay ignored - those are a cache the cooker rebuilds.
!examples/physics_lab/assets/
!examples/physics_lab/library/
