# Ours.
[submodule "modules/vkmLog"]
	path = modules/vkmLog
	url = https://github.com/V-KMilev/vkmLog.git
	branch = master
[submodule "modules/vkmPlatform"]
	path = modules/vkmPlatform
	url = https://github.com/V-KMilev/vkmPlatform.git
	branch = master
[submodule "modules/vkmAudio"]
	path = modules/vkmAudio
	url = https://github.com/V-KMilev/vkmAudio.git
	branch = master
[submodule "modules/vkmNetwork"]
	path = modules/vkmNetwork
	url = https://github.com/V-KMilev/vkmNetwork.git
	branch = master
[submodule "modules/vkmPhysics"]
	path = modules/vkmPhysics
	url = https://github.com/V-KMilev/vkmPhysics.git
	branch = master
[submodule "modules/vkmOpenGL"]
	path = modules/vkmOpenGL
	url = https://github.com/V-KMilev/vkmOpenGL.git
	branch = master
[submodule "modules/vkmVulkan"]
	path = modules/vkmVulkan
	url = https://github.com/V-KMilev/vkmVulkan.git
	branch = master

# Shared dependencies the engine owns. glm appears in engine API; stb decodes images
# and bakes font atlases. vkmOpenGL, vkmAudio, vkmNetwork and vkmPhysics take the
# engine's glm rather than vendoring their own, as a second backend will.
[submodule "modules/glm"]
	path = modules/glm
	url = https://github.com/g-truc/glm.git
[submodule "modules/stb"]
	path = modules/stb
	url = https://github.com/nothings/stb.git

# Editor and asset pipeline. Built only when the editor is, and linked by it and
# vkm_cook, never by the runtime: a shipped game imports nothing and draws no
# ImGui. cgltf reads glTF and GLB, ufbx reads FBX and OBJ, MikkTSpace gives imported
# meshes the tangents normal maps are baked against, meshoptimizer simplifies LOD
# levels and orders every cooked mesh for the GPU, and xatlas unwraps lightmap UVs.
[submodule "modules/imgui"]
	path = modules/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "modules/cgltf"]
	path = modules/cgltf
	url = https://github.com/jkuhlmann/cgltf.git
[submodule "modules/ufbx"]
	path = modules/ufbx
	url = https://github.com/ufbx/ufbx.git
[submodule "modules/mikktspace"]
	path = modules/mikktspace
	url = https://github.com/mmikk/MikkTSpace.git
[submodule "modules/meshoptimizer"]
	path = modules/meshoptimizer
	url = https://github.com/zeux/meshoptimizer.git
[submodule "modules/xatlas"]
	path = modules/xatlas
	url = https://github.com/jpcy/xatlas.git

# Serialization, linked by vkm_core, and profiling, linked by it with VKM_PROFILER.
[submodule "modules/json"]
	path = modules/json
	url = https://github.com/nlohmann/json
[submodule "modules/tracy"]
	path = modules/tracy
	url = https://github.com/wolfpld/tracy.git
