# Ours.
[submodule "modules/vkmGL"]
	path = modules/vkmGL
	url = https://github.com/V-KMilev/vkmGL.git
[submodule "modules/vkmLog"]
	path = modules/vkmLog
	url = https://github.com/V-KMilev/vkmLog.git

# Shared dependencies the engine owns. glm and glfw appear in engine API and
# platform code; stb decodes images and bakes font atlases. vkmGL consumes these
# rather than vendoring its own, so a second backend can too.
[submodule "modules/glm"]
	path = modules/glm
	url = https://github.com/g-truc/glm.git
[submodule "modules/glfw"]
	path = modules/glfw
	url = https://github.com/glfw/glfw.git
[submodule "modules/stb"]
	path = modules/stb
	url = https://github.com/nothings/stb.git

# Audio. Public domain, one header plus the implementation unit beside it; the
# engine owns the device behind it and nothing else includes it.
[submodule "modules/miniaudio"]
	path = modules/miniaudio
	url = https://github.com/mackron/miniaudio.git

# Editor and asset pipeline. Built only when the editor is, and linked through
# vkm_cook, never by the runtime: a shipped game imports nothing. cgltf reads
# glTF and GLB, ufbx reads FBX and OBJ, MikkTSpace gives imported meshes the
# tangents normal maps are baked against, meshoptimizer simplifies LOD levels
# and orders every cooked mesh for the GPU, and basis_universal supplies its
# scalar BC7 encoder - one file of it is compiled, so it is cloned shallow.
[submodule "modules/imgui"]
	path = modules/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "modules/cgltf"]
	path = modules/cgltf
	url = https://github.com/jkuhlmann/cgltf.git
[submodule "modules/ufbx"]
	path = modules/ufbx
	url = https://github.com/ufbx/ufbx.git
[submodule "modules/mikktspace"]
	path = modules/mikktspace
	url = https://github.com/mmikk/MikkTSpace.git
[submodule "modules/meshoptimizer"]
	path = modules/meshoptimizer
	url = https://github.com/zeux/meshoptimizer.git
[submodule "modules/basis_universal"]
	path = modules/basis_universal
	url = https://github.com/BinomialLLC/basis_universal.git
	shallow = true
[submodule "modules/freetype"]
	path = modules/freetype
	url = https://github.com/freetype/freetype.git

# Serialization and profiling.
[submodule "modules/json"]
	path = modules/json
	url = https://github.com/nlohmann/json
[submodule "modules/tracy"]
	path = modules/tracy
	url = https://github.com/wolfpld/tracy.git
