*.JPEG filter=lfs diff=lfs merge=lfs -text

*.png filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text

*.hdr filter=lfs diff=lfs merge=lfs -text
*.HDR filter=lfs diff=lfs merge=lfs -text

*.svg filter=lfs diff=lfs merge=lfs -text
*.SVG filter=lfs diff=lfs merge=lfs -text

*.bin filter=lfs diff=lfs merge=lfs -text
*.BIN filter=lfs diff=lfs merge=lfs -text
# Images GitHub has to render in Markdown cannot be LFS pointers: the raw URL
# the renderer follows returns the pointer text, so the image arrives broken.
# Nothing is lost by exempting them - these are brand and documentation files of
# a few KB, and LFS was never buying anything for them.
assets/logo/** -filter -diff -merge -text
assets/docs/** -filter -diff -merge -text

# A batch file is read by cmd.exe, which wants CRLF line ends.
*.cmd text eol=crlf
